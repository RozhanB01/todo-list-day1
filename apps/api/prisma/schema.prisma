generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  READER
  ADMIN
}

enum NovelStatus {
  DRAFT
  ONGOING
  COMPLETED
}

enum ChapterStatus {
  DRAFT
  PUBLISHED
}

/// Reader accounts. The author's account carries the ADMIN role.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  displayName  String
  role         Role     @default(READER)
  createdAt    DateTime @default(now())

  favorites Favorite[]
  bookmarks Bookmark[]
  progress  ReadingProgress[]
  views     NovelView[]

  @@map("profiles")
}

model Genre {
  id          String       @id @default(cuid())
  slug        String       @unique
  name        String
  description String?
  icon        String       @default("book")
  position    Int          @default(0)

  novels NovelGenre[]

  @@map("genres")
}

model Novel {
  id             String      @id @default(cuid())
  slug           String      @unique
  title          String
  subtitle       String?
  description    String      @db.Text
  contentWarning String?
  status         NovelStatus @default(DRAFT)
  coverImageUrl  String?
  coverPalette   String      @default("plum")
  coverMotif     String      @default("moon")
  readingMinutes Int?
  featured       Boolean     @default(false)
  featuredNote   String?
  moods          String[]    @default([])
  seoTitle       String?
  seoDescription String?
  searchText     String      @default("")
  isDemo         Boolean     @default(false)
  publishedAt    DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  chapters  Chapter[]
  genres    NovelGenre[]
  favorites Favorite[]
  bookmarks Bookmark[]
  progress  ReadingProgress[]
  views     NovelView[]

  @@index([status])
  @@map("novels")
}

model NovelGenre {
  novelId String
  genreId String

  novel Novel @relation(fields: [novelId], references: [id], onDelete: Cascade)
  genre Genre @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([novelId, genreId])
  @@map("novel_genres")
}

model Chapter {
  id             String        @id @default(cuid())
  novelId        String
  slug           String
  title          String
  summary        String?
  contentHtml    String        @db.Text
  contentText    String        @db.Text @default("")
  status         ChapterStatus @default(DRAFT)
  number         Int
  wordCount      Int           @default(0)
  readingMinutes Int           @default(1)
  publishedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  novel     Novel      @relation(fields: [novelId], references: [id], onDelete: Cascade)
  bookmarks Bookmark[]
  views     NovelView[]

  @@unique([novelId, slug])
  @@index([novelId, number])
  @@index([status, publishedAt])
  @@map("chapters")
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  novelId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  novel Novel @relation(fields: [novelId], references: [id], onDelete: Cascade)

  @@unique([userId, novelId])
  @@index([novelId])
  @@map("favorites")
}

model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  novelId   String
  chapterId String
  note      String?
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  novel   Novel   @relation(fields: [novelId], references: [id], onDelete: Cascade)
  chapter Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@unique([userId, chapterId])
  @@index([userId])
  @@map("bookmarks")
}

model ReadingProgress {
  id        String   @id @default(cuid())
  userId    String
  novelId   String
  chapterId String
  percent   Float    @default(0)
  finished  Boolean  @default(false)
  updatedAt DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  novel Novel @relation(fields: [novelId], references: [id], onDelete: Cascade)

  @@unique([userId, novelId])
  @@index([userId, updatedAt])
  @@map("reading_progress")
}

/// Notes readers send to the author from the contact page.
model Message {
  id        String   @id @default(cuid())
  name      String
  email     String
  body      String   @db.Text
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("messages")
}

/// One row per anonymous/signed-in visit, used for real reading statistics only.
model NovelView {
  id         String   @id @default(cuid())
  novelId    String
  chapterId  String?
  visitorKey String
  userId     String?
  createdAt  DateTime @default(now())

  novel   Novel    @relation(fields: [novelId], references: [id], onDelete: Cascade)
  chapter Chapter? @relation(fields: [chapterId], references: [id], onDelete: SetNull)
  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([novelId, createdAt])
  @@index([visitorKey, createdAt])
  @@map("novel_views")
}
